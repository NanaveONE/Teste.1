<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>Xbox ISO Extractor</ApplicationTitle>
    <ApplicationId>com.xboximageextractor.mobile</ApplicationId>
    <ApplicationDisplayVersion>0.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>2</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#121C2A" BaseSize="128,128" />
  </ItemGroup>
</Project>
